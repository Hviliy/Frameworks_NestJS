      "name": "1. Аутентификация",
      "item": [
        {
          "name": "Регистрация пользователя",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = `${Date.now()}${Math.floor(Math.random() * 1000)}`;",
                  "pm.collectionVariables.set('user_username', `user_${suffix}`);",
                  "pm.collectionVariables.set('user_email', `user_${suffix}@example.com`);",
                  "pm.collectionVariables.set('second_user_username', `second_${suffix}`);",
                  "pm.collectionVariables.set('second_user_email', `second_${suffix}@example.com`);",
                  "pm.collectionVariables.set('starts_at', new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString());",
                  "pm.collectionVariables.unset('user_token');",
                  "pm.collectionVariables.unset('second_user_token');",
                  "pm.collectionVariables.unset('admin_token');",
                  "pm.collectionVariables.unset('workshop_id');",
                  "pm.collectionVariables.unset('booking_id');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Пользователь зарегистрирован', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.username).to.eql(pm.collectionVariables.get('user_username'));",
                  "  pm.expect(body).not.to.have.property('password');",
                  "  pm.expect(body).not.to.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{user_username}}\",\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Вход пользователя",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Пользователь получил JWT', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('user_token', body.access_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{user_username}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
